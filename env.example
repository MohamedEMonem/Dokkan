# Database Configuration
POSTGRES_USER=dokkan_user
POSTGRES_PASSWORD=development_password
POSTGRES_DB=dokkan_dev

# Meilisearch Configuration
MEILI_MASTER_KEY=your_meilisearch_master_key_here

# MinIO S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Database URL (auto-configured for Docker)
DATABASE_URL=postgresql://dokkan_user:development_password@localhost:5432/dokkan_dev

# Application Configuration
NODE_ENV=development
API_PORT=3000
API_HOST=localhost

# JWT Configuration (Generate a secure secret)
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
#     schema.prisma
#   prisma.config.ts

# warn You already have a .gitignore file. Don't forget to add .env in it to not commit any private information.

# Next, choose how you want to set up your database:

# CONNECT EXISTING DATABASE:
#   1. Configure your DATABASE_URL in prisma.config.ts
#   2. Run npx prisma db pull to introspect your database.

# CREATE NEW DATABASE:
#   Local: npx prisma dev (runs Postgres locally in your terminal)
#   Cloud: npx create-db (creates a free Prisma Postgres database)

# Then, define your models in prisma/schema.prisma and run npx prisma migrate dev to apply your schema.

# Learn more: https://pris.ly/getting-started