# Database Configuration
POSTGRES_USER=dokkan_user
POSTGRES_PASSWORD=development_password
POSTGRES_DB=dokkan_dev

# Meilisearch Configuration
MEILI_MASTER_KEY=your_meilisearch_master_key_here

# MinIO S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Database URL (auto-configured for Docker)
DATABASE_URL=postgresql://dokkan_user:development_password@localhost:5432/dokkan_dev

# Application Configuration
NODE_ENV=development
API_PORT=3000
API_HOST=localhost

# JWT Configuration (Generate a secure secret)
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
#     schema.prisma
#   prisma.config.ts

