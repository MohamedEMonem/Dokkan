{
  "name": "@dokkan/source",
  "version": "0.0.0",
  "private": true,
  "description": "Welcome to Dokkan! This is a **full-stack e-commerce platform** built with modern technologies. This guide will help you get started quickly.",
  "keywords": [],
  "homepage": "https://github.com/MohamedEMonem/Dokkan#readme",
  "bugs": {
    "url": "https://github.com/MohamedEMonem/Dokkan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedEMonem/Dokkan.git"
  },
  "license": "MIT",
  "author": "Apollo-Team",
  "type": "commonjs",
  "main": "jest.preset.js",
  "workspaces": [
    "packages/*",
    "api"
  ],
  "scripts": {
    "start": "npm run start:all",
    "start:all": "nx run-many -t serve --projects=api,web",
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "build": "nx run-many -t build --all",
    "build:api": "nx build api --prod",
    "build:web": "nx build web --prod",
    "test": "nx run-many -t test --all",
    "test:api": "nx test api",
    "test:web": "nx test web",
    "test:coverage": "nx run-many -t test --all -- --coverage",
    "test:api:coverage": "nx test api -- --coverage",
    "test:web:coverage": "nx test web -- --coverage",
    "test:watch": "nx run-many -t test --all --watch",
    "test:api:watch": "nx test api --watch",
    "test:web:watch": "nx test web --watch",
    "lint": "nx run-many -t lint --all",
    "lint:api": "nx lint api",
    "lint:web": "nx lint web",
    "lint:fix": "nx run-many -t lint --all -- --fix",
    "lint:api:fix": "nx lint api -- --fix",
    "lint:web:fix": "nx lint web -- --fix",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:clean": "docker compose down -v",
    "infra:Totalclean": "docker system prune -a --volumes",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --require=.pnp.cjs prisma/seed.js",
    "nx:graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@nestjs/swagger": "^2.5.1",
    "@prisma/client": "^7.1.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nx/devkit": "22.4.5",
    "@nx/eslint": "22.4.5",
    "@nx/eslint-plugin": "22.4.5",
    "@nx/express": "22.4.5",
    "@nx/jest": "22.4.5",
    "@nx/js": "22.4.5",
    "@nx/nest": "22.4.5",
    "@nx/node": "22.4.5",
    "@nx/playwright": "22.4.5",
    "@nx/react": "22.4.5",
    "@nx/vite": "22.4.5",
    "@nx/web": "22.4.5",
    "@nx/webpack": "22.4.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "0.2.39",
    "@testing-library/react": "16.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "30.0.0",
    "jest-environment-jsdom": "30.0.0",
    "jest-environment-node": "^30.0.2",
    "jest-preset-angular": "16.0.0",
    "jest-util": "30.0.0",
    "jiti": "2.4.2",
    "nx": "22.4.5",
    "postcss": "^8.5.6",
    "prettier": "~3.6.2",
    "prisma": "^6.19.2",
    "react-refresh": "^0.10.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "webpack-cli": "^6.0.1"
  }
}
