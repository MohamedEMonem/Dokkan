{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "allowJs": true,            // Essential for incremental migration
    "checkJs": false,
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["**/*.ts", "src/config/minio.config.js", "src/utils/minioClient.js", "src/routes/upload.js"],
  "exclude": ["node_modules", "dist"]
}
