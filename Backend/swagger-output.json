    "/api/auth/profile": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current user profile",
        "description": "Retrieves the public profile data of the authenticated user.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully"
          },
          "401": {
            "description": "Access denied. Invalid or missing token."
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update user profile",
        "description": "Updates specific fields on the authenticated user profile. Unrecognized fields will be rejected.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Validation error (e.g., invalid fields, string length exceeded, or no valid fields provided)"
          },
          "401": {
            "description": "Access denied. Invalid or missing token."
          },
          "404": {
            "description": "Account not found or already deleted"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "Jane Doe"
                  },
                  "contactNumber": {
                    "type": "string",
                    "maxLength": 20,
                    "nullable": true,
                    "example": "+1234567890"
                  },
                  "profilePhotoUrl": {
                    "type": "string",
                    "maxLength": 255,
                    "nullable": true,
                    "example": "https://example.com/photo.jpg"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Delete user account",
        "description": "Performs a soft delete on the authenticated user account.",
