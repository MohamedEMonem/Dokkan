# .env
PORT=3000

POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=mydb

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

MEILI_MASTER_KEY=root

MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=rootpassword

DATABASE_URL="postgres://root:root@localhost:5432/mydb"

