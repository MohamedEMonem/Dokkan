{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend of dokkan",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:ts": "tsx watch src/server.ts",
    "build": "tsc",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:clean": "docker compose down -v",
    "infra:FullClean": "docker system prune -a --volumes",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "lint": "nx run-many -t lint --all",
    "lint:api": "nx lint api",
    "lint:fix": "nx run-many -t lint --all -- --fix",
    "lint:api:fix": "nx lint api -- --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^7.0.26",
    "multer": "^2.0.2",
    "nodemon": "^3.1.11",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "is-extglob": "^2.1.1",
    "nodemon": "^3.1.11",
    "prisma": "^7.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
