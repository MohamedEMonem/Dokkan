{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend of dokkan",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "./src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:clean": "docker compose down -v",
    "infra:FullClean": "docker system prune -a --volumes",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node src/prisma/seed.js",
    "lint": "nx run-many -t lint --all",
    "lint:api": "nx lint api",
    "lint:fix": "nx run-many -t lint --all -- --fix",
    "lint:api:fix": "nx lint api -- --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^7.0.26",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "prisma": "^7.4.1"
  }
}
