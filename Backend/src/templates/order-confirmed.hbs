<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="margin: 0; padding: 0; background: linear-gradient(180deg, #f6f7fb 0%, #eef2f7 100%);"
>
  <tr>
    <td align="center" style="padding: 32px 16px;">
      <table
        width="100%"
        border="0"
        cellspacing="0"
        cellpadding="0"
        style="max-width: 640px; background: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);"
      >
        <tr>
          <td style="padding: 0; background: linear-gradient(135deg, #111827 0%, #1f2937 55%, #334155 100%);">
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
              <tr>
                <td style="padding: 34px 40px; font-family: Arial, sans-serif; color: #ffffff;">
                  <div style="font-size: 12px; letter-spacing: 2.4px; text-transform: uppercase; opacity: 0.82; margin-bottom: 8px;">Dokkan</div>
                  <h1 style="margin: 0; font-size: 30px; line-height: 1.2; font-weight: 700;">Your order is confirmed</h1>
                  <p style="margin: 10px 0 0; font-size: 15px; line-height: 1.7; color: rgba(255, 255, 255, 0.9);">We have received your purchase and started processing it right away.</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding: 40px; font-family: Arial, sans-serif; color: #1f2937;">
            <p style="margin: 0 0 18px; font-size: 16px; line-height: 1.7;">Hi {{customerName}},</p>
            <p style="margin: 0 0 26px; font-size: 16px; line-height: 1.7; color: #4b5563;">
              Thanks for shopping with {{#if storeName}}{{storeName}}{{else}}Dokkan{{/if}}. Below is a quick summary of your order.
            </p>

            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin: 0 0 28px;">
              <tr>
                <td style="padding: 18px 20px; background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 16px;">
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td style="font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.08em;">Order Number</td>
                      <td align="right" style="font-size: 16px; font-weight: 700; color: #111827;">{{orderNumber}}</td>
                    </tr>
                    <tr>
                      <td style="padding-top: 10px; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.08em;">Order Date</td>
                      <td align="right" style="padding-top: 10px; font-size: 15px; color: #111827;">{{orderDate}}</td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin: 0 0 28px; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden;">
              <tr>
                <td style="padding: 18px 20px; background: #ffffff; border-bottom: 1px solid #e5e7eb;">
                  <h2 style="margin: 0; font-size: 18px; color: #111827;">Items purchased</h2>
                </td>
              </tr>
              {{#each items}}
              <tr>
                <td style="padding: 16px 20px; background: #ffffff; border-bottom: 1px solid #f3f4f6;">
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td style="font-size: 15px; font-weight: 700; color: #111827;">{{this.name}}</td>
                      <td align="right" style="font-size: 15px; font-weight: 700; color: #111827;">{{this.lineTotal}}</td>
                    </tr>
                    <tr>
                      <td style="padding-top: 6px; font-size: 13px; color: #6b7280;">Quantity: {{this.quantity}} | Unit price: {{this.unitPrice}}</td>
                      <td></td>
                    </tr>
                  </table>
                </td>
              </tr>
              {{/each}}
            </table>

            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin: 0 0 28px;">
              <tr>
                <td style="padding: 20px 24px; background: linear-gradient(135deg, #eff6ff 0%, #e0f2fe 100%); border-radius: 16px; border: 1px solid #bae6fd;">
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td style="font-size: 14px; color: #075985; text-transform: uppercase; letter-spacing: 0.08em;">Total Amount</td>
                      <td align="right" style="font-size: 24px; font-weight: 700; color: #0f172a;">{{totalAmount}}</td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <p style="margin: 0 0 8px; font-size: 15px; line-height: 1.8; color: #4b5563;">We’ll notify you as soon as your order changes status.</p>
            <p style="margin: 0; font-size: 15px; line-height: 1.8; color: #4b5563;">If you have any questions, reply to this email and the Dokkan Team will help you.</p>

            <div style="margin-top: 34px; padding-top: 22px; border-top: 1px solid #e5e7eb; color: #111827;">
              <p style="margin: 0 0 4px; font-size: 15px;">Best regards,</p>
              <p style="margin: 0; font-size: 16px; font-weight: 700;">Dokkan Team</p>
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>